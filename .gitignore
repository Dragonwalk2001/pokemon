# Rust build artifacts (workspace target and any crate-local target)
target/

# Project-local Rust toolchain (CARGO_HOME / RUSTUP_HOME)
/.rust/

# Temporary workspace files
/tmp/

# Godot import cache / editor state (game/ is an independent Godot project)
/game/.godot/

# Compiler artifacts that can appear outside target/
*.pdb
*.rlib
*.rmeta
*.d

# OS noise
.DS_Store
Thumbs.db
